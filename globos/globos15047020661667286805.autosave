class Globo
{
  float x, y,vx,vy;
  Globo (float _x, float _y)
  {
   x=_x;
   y=_y; 
   vx=random(-0.25,0.25);
   vy=random(-2,-0.5);
  }

  void update()
  {
    y+=vy;
    x+=vx;
  }

  void dibujate()
  {
      image(axel,x-50,y-40,150,150);
  }
  
}

ArrayList<Globo> globos;

PImage axel, teleco;

void setup()
{
  size(640,480);
  globos = new ArrayList<Globo>();  
  axel = loadImage("axel.png");
  teleco = loadImage("teleco.jpg");
}

void draw()
{
  background(200 , 1 , 200);
  image(teleco,0,0);
  
  for(int i=0;i<globos.size();i++)
  {
    globos.get(i).update();
    globos.get(i).dibujate();
  }
}

void mousePressed()
{
  globos.add(new Globo(mouseX,mouseY));
}
